# Runtime data and secrets
/data/
.env
.env.*
!.env.example
*.db
*.db-*
*.sqlite
*.sqlite3
*.pem
*.key
*.p12
*.pfx
*.log
# Reviewed RPA log samples (aggregate events only, no identifiers) are versioned
!/rpa/logs/*.log
# Python and local tooling
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
node_modules/
.publication-backup/
# Documentation build dependencies and intermediate output
/docs/.deps/
/docs/qa/
# Personal remote-access setup is never project documentation.
/docs/**/remote-access/
/docs/**/remote-acess/
# Terraform private configuration/state
*.tfstate*
*.tfvars
.terraform/
# External snapshots: review redistribution rights before publishing
/big_data/official_snapshots/
# Airflow working copy of inputs (regenerated by the DAG)
/big_data/staging/
# Landing zone of the daily collection (samples are versioned in big_data/amostras/)
/big_data/chegada/
# Intermediate HTML of the PDF generator (PDFs are versioned)
/docs/entregas/*.html
# Runtime output; retain only the reviewed synthetic demo summary required by Docker
/big_data/output/*
!/big_data/output/summary.json
/rpa/output/
/rpa/reports/
# Raw datasets and experimental weights stay local; the reviewed release is explicit below.
/vision/data/*
!/vision/data/dataset.example.yaml
!/vision/data/provenance.example.json
/vision/models/
/vision/datasets/
/vision/.test-deps/
/vision/*.py.before-guards
/vision/artifacts*/
/vision/runs/
/runs/
*.pt
*.onnx
# Deliver the exact selected checkpoint; keep every experimental checkpoint ignored.
!/vision/release/best.pt
# Local knowledge exports and working review sheets are not delivery documents.
/graphify-out/
/docs/knowledge/
/genai/avaliacao/*.review.md
/genai/reports/*.review.md
/robot/.models/
/robot/.verification/

# Runtime data and secrets
/data/
.env
.env.*
!.env.example
*.db
*.db-*
*.sqlite
*.sqlite3
*.pem
*.key
*.p12
*.pfx
*.log
# Python and local tooling
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
node_modules/
.publication-backup/
# Documentation build dependencies and intermediate output
/docs/.deps/
/docs/qa/
# Personal remote-access setup is never project documentation.
/docs/**/remote-access/
/docs/**/remote-acess/
# Terraform private configuration/state
*.tfstate*
*.tfvars
.terraform/
# External snapshots: review redistribution rights before publishing
/big_data/official_snapshots/
# Runtime output; retain only the reviewed synthetic demo summary required by Docker
/big_data/output/*
!/big_data/output/summary.json
/rpa/output/
/rpa/reports/
# Raw datasets and experimental weights stay local; the reviewed release is explicit below.
/vision/data/*
!/vision/data/dataset.example.yaml
!/vision/data/provenance.example.json
/vision/models/
/vision/datasets/
/vision/.test-deps/
/vision/*.py.before-guards
/vision/artifacts*/
/vision/runs/
/runs/
*.pt
*.onnx
# Deliver the exact selected checkpoint; keep every experimental checkpoint ignored.
!/vision/release/best.pt
# Rebuildable Graphify caches, machine paths and local Obsidian workspace
/graphify-out/cache/
/graphify-out/.graphify_*
/graphify-out/cost.json
/graphify-out/manual-pdf-text.txt
/graphify-out/obsidian/
